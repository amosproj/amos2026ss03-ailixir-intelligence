# ── OpenAI (used by Graphiti for LLM + embeddings) ───────────────────────────
OPENAI_API_KEY=sk-proj...

# ── OpenRouter (used by OCR service for vision extraction) ────────────────────
OPENROUTER_API_KEY=sk-or........

# ── Neo4j connection ──────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# ── Patient identity (optional — skips interactive prompts if set) ────────────
PATIENT_MRN=10042
PATIENT_NAME=Hans Schmidt
PATIENT_DOB=1979-03-12

# GCP Document AI (used by temporal_patient1_runner.py OCR)
# CR_PROCESSOR can be either:
#   projects/<project-id>/locations/<location>/processors/<processor-id>
# or just <processor-id> when GCP_PROJECT_ID and GCP_LOCATION are set.
CR_PROCESSOR=projects/my-project/locations/eu/processors/my-processor-id
GCP_PROJECT_ID=my-project
GCP_LOCATION=eu
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Cost estimate rates
# Checked against official pricing pages on 2026-06-03.
# Graphiti default OpenAI model: gpt-4.1-mini
# Graphiti default embedding model: text-embedding-3-small
# GCP OCR processor: Enterprise Document OCR Processor, first 5M pages/month
COST_CURRENCY=USD
OPENAI_LLM_INPUT_USD_PER_1M=0.40
OPENAI_LLM_OUTPUT_USD_PER_1M=1.60
OPENAI_EMBEDDING_USD_PER_1M=0.02
GCP_DOCUMENT_AI_USD_PER_1000_PAGES=1.50
