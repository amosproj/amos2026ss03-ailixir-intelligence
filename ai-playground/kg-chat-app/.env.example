# =========================
# Neo4j knowledge graph
# =========================
# Neo4j Desktop / local:
NEO4J_URI=neo4j://127.0.0.1:7687
# Neo4j Aura:
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j

# =========================
# LLM provider
# =========================
# Options:
# - vertex: uses Google Cloud ADC / Vertex AI
# - google-genai: uses GEMINI_API_KEY
LLM_PROVIDER=vertex
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# Vertex AI mode
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# API key mode
GEMINI_API_KEY=

# Native Graphiti hybrid search. Recommended for semantic questions.
GRAPHITI_SEARCH_ENABLED=true
GRAPHITI_SEARCH_LIMIT=10
GRAPHITI_TELEMETRY_ENABLED=false
OPENAI_API_KEY=

# =========================
# Query and schema controls
# =========================
KG_QUERY_LIMIT=20
KG_SCHEMA_PATTERN_LIMIT=50
KG_MAX_ROWS_FOR_ANSWER=30
KG_MAX_HISTORY_TURNS=6
KG_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=*
