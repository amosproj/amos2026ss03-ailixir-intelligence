# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed so the team knows what to set.

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=amos26
FIREBASE_WEB_API_KEY=...        # Firebase Console → Project Settings → General → google-services.json
FIREBASE_KEY_RELATIVE_PATH=amos26-firebase-adminsdk-fbsvc-c05787eb8f.json

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_DOCUMENTS_BUCKET=...        # bucket for uploaded documents  (API writes, workers read)
GCS_CYPHER_BUCKET=...           # bucket for exported Cypher graph files  (workers write, frontend reads)

# ── Vertex AI (Graphiti LLM + embeddings via Gemini) ─────────────────────────
# Auth uses Application Default Credentials — no API key needed.
#   Local:  gcloud auth application-default login
#   GCP:    Cloud Run service account is used automatically (needs roles/aiplatform.user)
VERTEX_PROJECT=amos26                         # GCP project ID
VERTEX_LOCATION=us-central1                   # region (us-central1 / europe-west4 / etc.)
VERTEX_LLM_MODEL=gemini-2.0-flash-001         # optional; this is the default
VERTEX_EMBEDDING_MODEL=text-embedding-005     # optional; this is the default

# ── OpenRouter (OCR vision model) ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OCR_MODEL=qwen/qwen2.5-vl-72b-instruct   # optional: override default vision model

# ── Neo4j (knowledge graph) ───────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687          # local Docker  — or — neo4j+s://xxxx.databases.neo4j.io  (Aura)
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password

# ── Scrapers subsystem (AstraDB vector store; see scrapers/README.md) ─────────
# Decoupled from the Neo4j graph. Used by the scrapers pipeline (see scrapers/README.md).
OPEN_AI_API=sk-...                    # OpenAI key — used for embeddings
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_TOKEN=AstraCS:...
ASTRA_DB_NAMESPACE=default_keyspace
ASTRA_DB_COLLECTION=health_ai
NCBI_ENTREZ_EMAIL=you@example.com     # optional; NCBI asks callers to identify themselves
NCBI_API_KEY=...                      # optional; raises the PubMed rate limit

# ── ElevenLabs (voice — Custom LLM integration, see api/voice.py) ─────────────
# Shared secret ElevenLabs sends back as `Authorization: Bearer <value>`.
# Set the SAME value as the "API key" field on the agent's Custom LLM config
# in the ElevenLabs dashboard. Required — requests without it are rejected.
ELEVENLABS_CUSTOM_LLM_SECRET=...
# Header name carrying the patient's Firebase UID, set in the ElevenLabs
# dashboard under Custom LLM -> Request headers as a `{{secret__user_id}}`
# dynamic variable. Optional; defaults to X-User-Id.
ELEVENLABS_USER_ID_HEADER=X-User-Id

# ── Local dev / testing ───────────────────────────────────────────────────────
TEST_USER_EMAIL=test@ailixir.dev
TEST_USER_PASSWORD=test1234
